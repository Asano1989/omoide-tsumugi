<%# Link to the "Next" page
  - available local variables
    url:           url to the next page
    current_page:  a page object for the currently displayed page
    total_pages:   total number of pages
    per_page:      number of items to fetch per page
    remote:        data-remote
-%>
<%= link_to_unless current_page.last?, t('views.pagination.next').html_safe, url, rel: 'next', remote: remote, class: "w-10 h-10 mr-2 flex items-center justify-center rounded-full bg-white border border-amber-200 shadow-sm text-lg text-amber-600 hover:bg-amber-50 transition-all active:scale-95" %>
