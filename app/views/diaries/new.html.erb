<div class="min-h-screen bg-lime-50 flex flex-col items-center py-8 px-4 sm:px-6 lg:px-8">
  <!-- Container -->
  <div class="w-full max-w-md p-3 space-y-7">
    <!-- Header Section -->
    <h1 class="text-3xl font-extrabold text-lime-800 text-center mb-6">日記を投稿</h1>

    <!-- Form Card -->
    <div class="bg-white rounded-2xl shadow-md border-2 border-amber-100 p-8 sm:p-10 space-y-8">
      <%= form_with(model: @diary, method: :post, data: { turbo: false }, local: true) do |f| %>
        <%= render 'shared/error_messages', object: f.object %>

        <!-- Date Field -->
        <div class="mb-6">
          <div class="flex items-center mb-2">
            <span class="icon-[formkit--date] text-xl text-amber-600 mr-2"></span>
            <%= f.label :date, "日付", class: "font-semibold text-amber-800 text-lg" %>
          </div>
          <%= f.date_field :date, class: "w-full p-3 border border-lime-300 rounded-lg bg-white text-lime-800 shadow-sm" %>
        </div>

        <!-- Emoji Field -->
        <div class="mb-6">
          <div class="flex items-center mb-2">
            <span class="icon-[lucide--smile-plus] text-xl text-amber-600 mr-2"></span>
            <%= f.label :emoji_id, "絵文字", class: "font-semibold text-amber-800 text-lg" %>
          </div>
          <div class="relative">
            <%= f.select :emoji_id, options_from_collection_for_select(@emojis, :id, :character), include_blank: "選択してください", class: "w-full p-3 border-2 border-lime-300 rounded-lg bg-white text-lime-800 text-2xl shadow-sm appearance-none cursor-pointer" %>
          </div>
        </div>

        <!-- Child Field -->
        <div class="mb-6">
          <div class="flex items-center mb-2">
            <span class="icon-[hugeicons--child] text-xl text-amber-600 mr-2"></span>
            <%= f.label :child_ids, "どの子？", class: "font-semibold text-amber-800 text-lg" %>
          </div>
          <div class="relative">
            <%= f.select :child_ids, Diary.child_combination_options(current_user.family), include_blank: "選択してください", name: "diary[child_ids][]", class: "w-full p-3 border-2 border-lime-300 rounded-lg bg-white text-lime-800 shadow-sm appearance-none cursor-pointer" %>
          </div>
        </div>

        <!-- Body Field -->
        <div class="mb-8">
          <div class="flex items-center mb-2">
            <span class="icon-[mdi--lead-pencil] text-xl text-amber-600 mr-2"></span>
            <%= f.label :body, "今日は何があった？", class: "font-semibold text-amber-800 text-lg" %>
          </div>
          <%= f.text_area :body, class: "w-full p-3 border border-lime-300 rounded-lg h-28 resize-y bg-white text-lime-800 shadow-sm", placeholder: "今日あったことを書いてみよう！" %>
        </div>

        <!-- Submit Button -->
        <div class="text-center">
          <%= f.submit "投稿する", class: "w-full bg-lime-300 hover:bg-lime-400 text-lime-900 font-bold py-3 px-6 rounded-full shadow-md transition duration-300 ease-in-out" %>
        </div>
      <% end %>
    </div>

  </div>
</div>
